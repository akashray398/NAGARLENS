# NAGARLENS Backend Application Environment Variables
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL / PostGIS Database Connections
DATABASE_URL=postgresql+asyncpg://nagarlens_user:nagarlens_dev_secret_change_me@localhost:5432/nagarlens_db
DATABASE_URL_SYNC=postgresql://nagarlens_user:nagarlens_dev_secret_change_me@localhost:5432/nagarlens_db

# Security & CORS Configuration
SECRET_KEY=dev_secret_key_minimum_32_chars_long_for_security_compliance
CORS_ORIGINS=["http://localhost", "http://localhost:8000", "http://localhost:3000"]
