# NAGARLENS Infrastructure Compose Environment Template
#
# LOCAL DEVELOPMENT INSTRUCTIONS:
# 1. Copy this file to create your local .env file:
#    cp infrastructure/docker/.env.example infrastructure/docker/.env
#
# 2. Run Docker Compose with the --env-file flag:
#    docker compose -f infrastructure/docker/docker-compose.yml --env-file infrastructure/docker/.env up -d
#
# IMPORTANT FOR PRODUCTION / STAGING:
# Set strong, unique values for POSTGRES_PASSWORD and SECRET_KEY!
# Never commit the actual .env file or production secrets to Git.

ENVIRONMENT=development
POSTGRES_DB=nagarlens_db
POSTGRES_USER=nagarlens_user
POSTGRES_PASSWORD=nagarlens_dev_secret_change_me
POSTGRES_PORT=5432
BACKEND_PORT=8000
SECRET_KEY=dev_secret_key_minimum_32_chars_long_for_security_compliance
CORS_ORIGINS: ${CORS_ORIGINS:-'["http://localhost", "http://localhost:8000", "http://localhost:3000"]'}
